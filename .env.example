APP_ENV=development
APP_NAME=transaction-webhook-service

# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (recommended for persistent services)
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DATABASE_SSL_MODE=require

API_POOL_SIZE=5
API_MAX_OVERFLOW=5
WORKER_POOL_SIZE=3
WORKER_MAX_OVERFLOW=2

PROCESSING_DELAY_SECONDS=30

WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=90
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_CONCURRENCY=10
# true = run the worker inside the API process (single free Render web service). false = separate worker process.
RUN_WORKER_IN_API=false
MAX_JOB_ATTEMPTS=3

WEBHOOK_SIGNATURE_ENABLED=false
WEBHOOK_SIGNATURE_REQUIRED_IN_PRODUCTION=true
WEBHOOK_SIGNATURE_PROVIDER=generic
WEBHOOK_SIGNING_SECRET=
WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature
WEBHOOK_TIMESTAMP_HEADER=X-Webhook-Timestamp
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

MAX_REQUEST_BYTES=65536

# Serve the built-in web page at /ui
ENABLE_UI=true

LOG_LEVEL=INFO
LOG_FORMAT=json

# Flyway (JDBC, direct or session-pooled connection - NOT the transaction pooler)
FLYWAY_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
FLYWAY_USER=
FLYWAY_PASSWORD=
